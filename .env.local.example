# Copy this file to .env.local and fill in the values, then restart `npm run dev`.
# .env.local is gitignored; this example file is safe to commit.
#
# The site runs fine without any of these — image uploads simply fall back to
# pasting an image URL. See SUPABASE_SETUP.md for where to find each value.

# --- Supabase Storage (image uploads) ------------------------------------
# Supabase dashboard -> Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> anon / publishable key. Required for login.
# Safe to expose: row level security decides what it can actually reach.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API Keys -> service_role key.
# SERVER ONLY. Never rename this to NEXT_PUBLIC_*, never paste it into client
# code, and never commit it — it bypasses all row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# The storage bucket uploads are written to. Must exist and be public-read.
# Defaults to bidmart-images if left unset.
SUPABASE_STORAGE_BUCKET=bidmart-images

# --- Sessions -------------------------------------------------------------
# Any long random string. lib/auth.js falls back to a dev-only default, which
# must not be used anywhere public.
SESSION_SECRET=
