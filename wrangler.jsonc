{
  "$schema": "node_modules/wrangler/config-schema.json",

  // This name MUST match the Worker you deploy to in Cloudflare.
  //
  // OpenNext adds a WORKER_SELF_REFERENCE service binding that points the
  // Worker at itself (it needs that to revalidate its own pages). That binding
  // is built from the name below, so if this doesn't match the real Worker you
  // get: "Service binding 'WORKER_SELF_REFERENCE' references Worker 'x' which
  // was not found".
  //
  // Committing this file is what makes the name stable — without it wrangler
  // guesses a new one on every build.
  "name": "bid-mart1",

  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-07",

  // nodejs_compat is required: Next.js server code uses Node built-ins
  // (crypto, buffer, stream) that Workers only provide with this flag.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // OpenNext's worker.js always exports these Durable Object classes, whether
  // or not the app actually uses them — BidMart doesn't (every route is
  // force-dynamic, so there's no incremental cache for them to back). Binding
  // them is harmless either way, since a Durable Object is only "live" if
  // something in the request path calls its binding, which nothing here does.
  "durable_objects": {
    "bindings": [
      { "name": "BucketCachePurge", "class_name": "BucketCachePurge" },
      { "name": "DOQueueHandler", "class_name": "DOQueueHandler" },
      { "name": "DOShardedTagCache", "class_name": "DOShardedTagCache" }
    ]
  },

  // Required the first time a Durable Object class is bound — Cloudflare needs
  // to know how to provision storage for it. All three of OpenNext's classes
  // use the SQLite-backed storage API (ctx.storage.sql), which is what
  // "new_sqlite_classes" is for, as opposed to the older "new_classes".
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BucketCachePurge", "DOQueueHandler", "DOShardedTagCache"]
    }
  ]
}
